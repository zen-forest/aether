{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$extensions": {
    "aether": {
      "defaultTheme": "dark",
      "themes": [
        {
          "id": "dark",
          "label": "Dark",
          "scheme": "dark"
        },
        {
          "id": "light",
          "label": "Light",
          "scheme": "light"
        }
      ]
    }
