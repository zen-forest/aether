  "shadow": {
    "sm": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1,
            "unit": "px"
          },
          "blur": {
            "value": 2,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          },
          "color": "rgb(0 0 0 / 0.4)"
        }
      ],
      "$extensions": {
        "aether": {
          "cssVariable": "--elevation-sm",
          "css": {
            "dark": "0 1px 2px rgb(0 0 0 / 0.4)",
            "light": "0 1px 2px rgb(0 0 0 / 0.06)"
          },
          "values": {
            "dark": [
              {
                "offsetX": {
                  "value": 0,
                  "unit": "px"
                },
                "offsetY": {
                  "value": 1,
